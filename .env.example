# ---------- API ----------
NODE_ENV=development
API_PORT=4000

DATABASE_URL=postgres://mockmint:mockmint@localhost:5432/mockmint
REDIS_URL=redis://localhost:6379

# Access token: short-lived, sent as Bearer. Refresh: rotating, httpOnly cookie.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Where the browser app runs — used for CORS + cookie domain.
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# Seed credentials (demo accounts created by `npm run db:seed`)
SEED_ADMIN_EMAIL=admin@mockmint.in
SEED_ADMIN_PASSWORD=MockMint@2026
SEED_STUDENT_EMAIL=aarav@example.com
SEED_STUDENT_PASSWORD=demo1234

# ---------- WEB ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
